{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleave",
  "version": "0.6.0",
  "identifier": "app.cleave.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "beforeDevCommand": "npm --prefix ../frontend run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": { "resources/backend/": "backend/" },
    "shortDescription": "Reachability-ranked attack path analysis for AWS",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
