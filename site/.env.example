# Supabase — website auth (Google / GitHub / email). Both values are PUBLIC and safe to ship
# in the frontend bundle. Copy this file to .env.local and fill in your project's values.
# Find them in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
