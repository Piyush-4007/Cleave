# Copy to .env and fill in. NOTHING here is a real secret — dev defaults only.

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=cleave_dev_password
NEO4J_URI=bolt://neo4j:7687

# --- Postgres ---
POSTGRES_USER=cleave
POSTGRES_PASSWORD=cleave_dev_password
POSTGRES_DB=cleave
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- AWS (how Cleave reads an account) ---
# The read-only role Cleave assumes. In the product, the user pastes their own.
CLEAVE_ROLE_ARN=arn:aws:iam::<YOUR_ACCOUNT_ID>:role/CleaveAudit
AWS_REGION=us-east-1
# Where the standard boto3 credential chain finds creds to assume the role above.
# Dev: your `aws login` session in ~/.aws. Leave blank to use the default chain.
AWS_PROFILE=

# Raw collector output (JSON dumps, so the graph can rebuild without re-hitting AWS)
CLEAVE_OUTPUT_DIR=/data/raw

# Credential-in-content scanning: read S3 object BODIES to find leaked keys. Off by
# default — it needs s3:GetObject, which the default read-only role does not grant.
# See docs/opt-in-credscan.md before enabling.
CLEAVE_CREDSCAN=false

# Scan concurrency: threads per fan-out (regions, IAM principals, S3 buckets). The scan is
# network-bound; raise for speed, lower if AWS throttles you. 1 = fully serial.
CLEAVE_SCAN_WORKERS=16

# --- API / desktop ---
# Graph store for the API: neo4j (compose stack, falls back to the raw dump) | memory
CLEAVE_GRAPH_STORE=neo4j
# Non-empty => every route except /health needs an X-Cleave-Token header (desktop sets one)
CLEAVE_API_TOKEN=
CLEAVE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
