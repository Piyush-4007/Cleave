
# Teams remediation delivery (open a PR) — OPT-IN, off when blank.
# Fine-grained PAT scoped to ONLY the infra repo: Contents + Pull requests read/write.
# Never commit a real token; this file is the template, your real values go in .env.
CLEAVE_GITHUB_REPO=
CLEAVE_GITHUB_TOKEN=
CLEAVE_PR_BASE=main
