{
  "name": "Allow ForAllValues:StringEquals on aws:CalledVia holds for a direct call (empty set) -> CERTAIN",
  "note": "AWS: ForAllValues returns true when the key is not in the request. That is why it is dangerous on an Allow.",
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "*",
          "Condition": {
            "ForAllValues:StringEquals": {
              "aws:CalledVia": "athena.amazonaws.com"
            }
          }
        }
      ]
    }
  ],
  "query": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::b/k",
    "principal": "arn:aws:iam::111122223333:user/alice"
  },
  "expect": {
    "decision": "ALLOW",
    "confidence": "CERTAIN"
  }
}
