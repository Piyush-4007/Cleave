{
  "name": "KMS: an explicit Deny in the key policy blocks even kms:* in the identity policy",
  "kms": true,
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "kms:*",
          "Resource": "*"
        }
      ]
    }
  ],
  "resource_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": "kms:*",
        "Resource": "*",
        "Principal": {
          "AWS": "arn:aws:iam::111122223333:root"
        }
      },
      {
        "Effect": "Deny",
        "Action": "kms:Decrypt",
        "Resource": "*",
        "Principal": {
          "AWS": "arn:aws:iam::111122223333:user/alice"
        }
      }
    ]
  },
  "query": {
    "action": "kms:Decrypt",
    "resource": "arn:aws:kms:us-east-1:111122223333:key/abcd-1234",
    "principal": "arn:aws:iam::111122223333:user/alice"
  },
  "expect": {
    "decision": "DENY",
    "confidence": "CERTAIN"
  }
}