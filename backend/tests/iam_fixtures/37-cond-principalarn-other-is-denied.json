{
  "name": "StringEquals aws:PrincipalArn naming someone else -> implicit DENY",
  "note": "v1 reported this as a POSSIBLE allow: a false edge for every principal except bob.",
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "aws:PrincipalArn": "arn:aws:iam::111122223333:user/bob"
            }
          }
        }
      ]
    }
  ],
  "query": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::b/k",
    "principal": "arn:aws:iam::111122223333:user/alice"
  },
  "expect": {
    "decision": "DENY",
    "confidence": "CERTAIN"
  }
}
