{
  "name": "KMS: identity kms:Decrypt but the key policy does NOT enable IAM -> DENY",
  "note": "The key-policy precedence rule: without a root delegation (or a statement naming the principal), an identity policy grants NOTHING on a KMS key. v1 let the identity allow through.",
  "kms": true,
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "kms:Decrypt",
          "Resource": "arn:aws:kms:us-east-1:111122223333:key/abcd-1234"
        }
      ]
    }
  ],
  "resource_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": "kms:*",
        "Resource": "*",
        "Principal": {
          "AWS": "arn:aws:iam::111122223333:user/bob"
        }
      }
    ]
  },
  "query": {
    "action": "kms:Decrypt",
    "resource": "arn:aws:kms:us-east-1:111122223333:key/abcd-1234",
    "principal": "arn:aws:iam::111122223333:user/alice"
  },
  "expect": {
    "decision": "DENY",
    "confidence": "CERTAIN"
  }
}