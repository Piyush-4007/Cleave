{
  "name": "ec2:RunInstances alone is not admin-equivalent (no role to carry)",
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "ec2:RunInstances",
            "ec2:Describe*"
          ],
          "Resource": "*"
        }
      ]
    }
  ],
  "expect_grants_admin": {
    "decision": "DENY",
    "confidence": "CERTAIN"
  },
  "expect_full_admin": false
}
