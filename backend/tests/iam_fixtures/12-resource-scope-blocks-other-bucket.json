{
  "name": "The same grant does NOT reach a different bucket (implicit deny)",
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::cg-data/*"
        }
      ]
    }
  ],
  "query": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::other-bucket/x"
  },
  "expect": {
    "decision": "DENY",
    "confidence": "CERTAIN"
  }
}
