{
  "name": "An SCP level (root -> OU -> account) without a matching Allow -> DENY",
  "note": "SCPs need an Allow at EVERY level of the hierarchy. They never grant anything.",
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "*",
          "Resource": "*"
        }
      ]
    }
  ],
  "scps": [
    [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "*",
            "Resource": "*"
          }
        ]
      }
    ],
    [
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "s3:*",
            "Resource": "*"
          },
          {
            "Effect": "Allow",
            "Action": "ec2:*",
            "Resource": "*"
          }
        ]
      }
    ]
  ],
  "query": {
    "action": "iam:AttachUserPolicy",
    "resource": "arn:aws:iam::111122223333:user/alice",
    "principal": "arn:aws:iam::111122223333:user/alice"
  },
  "expect": {
    "decision": "DENY",
    "confidence": "CERTAIN"
  }
}
