{
  "name": "Resource ARNs are case-sensitive (S3 keys are) - CG-DATA != cg-data",
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::CG-DATA/*"
        }
      ]
    }
  ],
  "query": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::cg-data/x"
  },
  "expect": {
    "decision": "DENY",
    "confidence": "CERTAIN"
  }
}
