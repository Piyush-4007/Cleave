{
  "name": "A bucket policy naming somebody else does not allow us",
  "policies": [],
  "resource_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::111122223333:user/someone-else"
        },
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::cg-data/secrets/.env"
      }
    ]
  },
  "query": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::cg-data/secrets/.env",
    "principal": "arn:aws:iam::111122223333:user/outsider"
  },
  "expect": {
    "decision": "DENY",
    "confidence": "CERTAIN"
  }
}
