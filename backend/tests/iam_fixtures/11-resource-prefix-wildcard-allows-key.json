{
  "name": "s3:GetObject on 'bucket/*' permits a key inside that bucket",
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::cg-data/*"
        }
      ]
    }
  ],
  "query": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::cg-data/secrets/.env"
  },
  "expect": {
    "decision": "ALLOW",
    "confidence": "CERTAIN"
  }
}
