{
  "name": "Account-root delegation combined with an identity Allow does permit the read",
  "policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::cg-data/*"
        }
      ]
    }
  ],
  "resource_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::111122223333:root"
        },
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::cg-data/secrets/.env"
      }
    ]
  },
  "query": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::cg-data/secrets/.env",
    "principal": "arn:aws:iam::111122223333:user/outsider"
  },
  "expect": {
    "decision": "ALLOW",
    "confidence": "CERTAIN"
  }
}
